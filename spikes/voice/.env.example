# S1 voice spike — copy to .env.local (gitignored) and fill in. Never commit real values.

# LiveKit Cloud project (free tier): Settings → Keys. Also enables LiveKit Inference
# (combos A and C need no other keys).
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Combo B only: https://dashboard.sarvam.ai → API keys.
SARVAM_API_KEY=

# Which pipeline to run: A | B | C | D (see agent.py COMBOS). D = female Gemini voice, no extra keys.
VOICE_COMBO=D

# Optional overrides (defaults in agent.py).
# LLM_MODEL=google/gemma-4-31b-it
# CARTESIA_VOICE=<female Indian voice id from play.cartesia.ai, e.g. Arushi / Riya / Aarti>
# GEMINI_VOICE=Leda            # female: Leda, Kore, Aoede
# SARVAM_SPEAKER=priya          # female: priya, neha, ritu, simran, kavya, ishita, shreya
# ENDPOINTING_MIN=0.8           # seconds of silence before your turn can end
# ENDPOINTING_MAX=2.5
