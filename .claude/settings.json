{
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(npx drizzle-kit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push origin chore/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push -u origin spike/*)",
      "Bash(git push origin spike/*)",
      "Bash(git push -u origin milestone/*)",
      "Bash(git push origin milestone/*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(uv:*)",
      "Bash(ls:*)",
      "Bash(grep:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.dev)",
      "Read(./.env.test)",
      "Read(./.env.staging)",
      "Read(./.env.production)",
      "Read(./.env.prod)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.dev)",
      "Read(./**/.env.test)",
      "Read(./**/.env.staging)",
      "Read(./**/.env.production)",
      "Read(./**/.env.prod)",
      "Read(./secrets/**)",
      "Bash(git push)",
      "Bash(git push -u)",
      "Bash(git push origin)",
      "Bash(git push -u origin)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push *+main*)",
      "Bash(git push *HEAD*)",
      "Bash(git push -f*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push *--force*)",
      "Bash(git push -fu*)",
      "Bash(git push * -fu*)",
      "Bash(git push -uf*)",
      "Bash(git push * -uf*)",
      "Bash(git push * +*)",
      "Bash(git push * :*)",
      "Bash(git push *--delete*)",
      "Bash(git push -d*)",
      "Bash(git push * -d)",
      "Bash(git push * -d *)",
      "Bash(git push *--prune*)",
      "Bash(git push *--tags*)",
      "Bash(git push *--all*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *://*)",
      "Bash(git push *git@*)",
      "Bash(git push *--repo*)",
      "Bash(git remote add*)",
      "Bash(git remote set-url*)",
      "Bash(git remote rename*)",
      "Bash(gh pr merge*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo rename*)",
      "Bash(gh repo archive*)",
      "Bash(gh api *DELETE*)",
      "Bash(gh api *PATCH*)",
      "Bash(gh api *PUT*)",
      "Bash(gh api *-X delete*)",
      "Bash(gh api *-Xdelete*)",
      "Bash(gh api *--method delete*)",
      "Bash(gh api *--method=delete*)",
      "Bash(gh api *-X patch*)",
      "Bash(gh api *-Xpatch*)",
      "Bash(gh api *--method patch*)",
      "Bash(gh api *--method=patch*)",
      "Bash(gh api *-X put*)",
      "Bash(gh api *-Xput*)",
      "Bash(gh api *--method put*)",
      "Bash(gh api *--method=put*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/format-lint.mjs"
          }
        ]
      }
    ]
  }
}
